# ==================== MOBILEFACENET ONNX ====================
MOBILEFACENET_SESSION = None

def get_mobilefacenet_session():
    """Lazy load MobileFaceNet ONNX session"""
    global MOBILEFACENET_SESSION
    if MOBILEFACENET_SESSION is None:
        try:
            MOBILEFACENET_SESSION = ort.InferenceSession(
                'models/mobilefacenet.onnx',
                providers=['CPUExecutionProvider']
            )
            print("✅ MobileFaceNet ONNX loaded")
        except Exception as e:
            print(f"❌ MobileFaceNet load failed: {e}")
            MOBILEFACENET_SESSION = None
    return MOBILEFACENET_SESSION

# ==================== HÀM TẠO PNR ====================
def generate_pnr():
    chars = string.ascii_uppercase + string.digits
    chars = ''.join(c for c in chars if c not in 'O0I1')
    return ''.join(random.choice(chars) for _ in range(6))

def generate_seat_number():
    rows = random.randint(1, 30)
    cols = random.choice(['A', 'B', 'C', 'D', 'E', 'F'])
    return f"{rows}{cols}"

def generate_gate():
    gates = ['G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'G8', 'G9', 'G10']
    return random.choice(gates)

# ==================== TRÍCH XUẤT VECTOR MOBILEFACENET ====================
def extract_face_vector_from_multiple(image_paths):
    """
    Trích xuất vector MobileFaceNet từ NHIỀU ảnh và lấy trung bình
    - Detect mặt bằng Haar Cascade
    - Crop mặt chính xác
    - Resize 112x112
    """
    try:
        if isinstance(image_paths, str):
            image_paths = [image_paths]
        
        # Lấy ONNX session
        session = get_mobilefacenet_session()
        if session is None:
            print("❌ MobileFaceNet session không khả dụng")
            return None
        
        input_name = session.get_inputs()[0].name
        output_name = session.get_outputs()[0].name
        
        # Load Haar Cascade
        face_cascade = cv2.CascadeClassifier(
            cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
        )
        
        all_encodings = []
        print(f"🔍 Đang trích xuất MobileFaceNet từ {len(image_paths)} ảnh...")
        
        for idx, image_path in enumerate(image_paths):
            try:
                if not os.path.exists(image_path):
                    print(f"⚠️ Ảnh {idx+1} không tồn tại: {image_path}")
                    continue
                
                # Đọc ảnh GỐC (không resize)
                img = cv2.imread(image_path)
                if img is None:
                    print(f"⚠️ Ảnh {idx+1} không đọc được")
                    continue
                
                print(f"   Ảnh {idx+1} shape: {img.shape}")
                
                # Detect mặt bằng Haar Cascade
                gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
                faces = face_cascade.detectMultiScale(
                    gray, 
                    scaleFactor=1.05,
                    minNeighbors=3,
                    minSize=(30, 30)
                )
                
                if len(faces) == 0:
                    print(f"   ⚠️ Không tìm thấy mặt, dùng toàn bộ ảnh")
                    face_img = img
                else:
                    # Lấy mặt lớn nhất (gần camera nhất)
                    faces = sorted(faces, key=lambda f: f[2]*f[3], reverse=True)
                    x, y, w, h = faces[0]
                    face_img = img[y:y+h, x:x+w]
                    print(f"   ✅ Crop mặt: {face_img.shape} (từ {len(faces)} mặt)")
                
                # Resize 112x112
                face_img = cv2.resize(face_img, (112, 112))
                
                # Lưu ảnh crop cho ảnh đầu tiên
                if idx == 0:
                    dir_name = os.path.dirname(image_path)
                    base_name = os.path.basename(image_path)
                    name, ext = os.path.splitext(base_name)
                    crop_path = os.path.join(dir_name, f"crop_{name}.jpg")
                    cv2.imwrite(crop_path, face_img)
                    print(f"   ✅ Lưu crop: {crop_path}")
                
                # Preprocessing (GIỐNG NODE 2)
                face_rgb = cv2.cvtColor(face_img, cv2.COLOR_BGR2RGB)
                face_rgb = face_rgb.astype(np.float32) / 255.0
                mean = np.array([0.5, 0.5, 0.5], dtype=np.float32)
                std = np.array([0.5, 0.5, 0.5], dtype=np.float32)
                face_rgb = (face_rgb - mean) / std
                face_rgb = np.transpose(face_rgb, (2, 0, 1))
                face_rgb = np.expand_dims(face_rgb, axis=0)
                
                # Inference
                outputs = session.run([output_name], {input_name: face_rgb})
                embedding = outputs[0][0]
                embedding = embedding / np.linalg.norm(embedding)
                
                all_encodings.append(embedding)
                print(f"   ✅ Ảnh {idx+1}: OK (vector length: {len(embedding)})")
                    
            except Exception as e:
                print(f"   ❌ Ảnh {idx+1} lỗi: {e}")
                continue
        
        if not all_encodings:
            print("❌ Không có ảnh nào trích xuất được")
            return None
        
        # Lấy TRUNG BÌNH của tất cả vector
        avg_encoding = np.mean(all_encodings, axis=0)
        avg_encoding = avg_encoding / np.linalg.norm(avg_encoding)
        
        print(f"✅ Đã trung bình {len(all_encodings)} vector MobileFaceNet")
        return avg_encoding.tolist()
        
    except Exception as e:
        print(f"❌ Lỗi trích xuất: {e}")
        import traceback
        traceback.print_exc()
        return None

def save_face_vector_to_db(user_id, face_image_paths):
    """Trích xuất vector MobileFaceNet từ NHIỀU ảnh và lưu vào database"""
    try:
        if isinstance(face_image_paths, str):
            face_image_paths = [face_image_paths]
        
        vector = extract_face_vector_from_multiple(face_image_paths)
        
        if vector:
            conn = get_db()
            c = conn.cursor()
            vector_json = json.dumps(vector)
            c.execute("UPDATE users SET face_encoding=? WHERE id=?", (vector_json, user_id))
            conn.commit()
            print(f"✅ Đã lưu vector MobileFaceNet cho user {user_id} (từ {len(face_image_paths)} ảnh)")
            return vector
        return None
    except Exception as e:
        print(f"❌ Lỗi lưu vector face: {e}")
        return None

def save_face_images(face_images, user_id):
    """Lưu TẤT CẢ ảnh khuôn mặt vào thư mục uploads/faces - KHÔNG RESIZE"""
    saved_paths = []
    try:
        for idx, face_image in enumerate(face_images):
            img = Image.open(face_image)
            filename = f"face_{user_id}_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{idx}.jpg"
            filepath = os.path.join('uploads/faces', filename)
            # KHÔNG resize, giữ nguyên ảnh gốc
            img.save(filepath, 'JPEG', quality=95)
            saved_paths.append(filepath)
            print(f"✅ Đã lưu ảnh {idx+1}: {filepath} (size: {img.size})")
        return saved_paths
    except Exception as e:
        print(f"❌ Lỗi lưu ảnh: {e}")
        return []

