        return jsonify({'error': 'Không tìm thấy user'}), 404
    c.execute("SELECT * FROM checkin_requests WHERE user_id=? ORDER BY created_at DESC", (user_id,))
    requests = c.fetchall()
    c.execute("SELECT * FROM activity_logs WHERE user_id=? ORDER BY created_at DESC LIMIT 10", (user_id,))
    logs = c.fetchall()
    
    result = {
        'user': dict(user),
        'requests': [dict(r) for r in requests],
        'logs': [dict(l) for l in logs],
        'status': {
            'pending_approval': user['status'] == 'pending',
            'checked_in': bool(user['checked_in']),
            'gate_passed': bool(user['gate_passed']),
            'boarded': bool(user['boarded'])
        }
    }
    
    if user.get('face_image_path'):
        result['user']['face_image_url'] = f"/api/face_image/{user['id']}"
    
    return jsonify(result)

